# ПРИМЕР НАСТРОЕК СЕРВЕРА XCAR.
#
# На Render: эти же строки вписываются в Render → ваш сервис → Environment
#   (Add Environment Variable). Файл при этом не нужен.
# На своём компьютере / Ubuntu: скопируйте этот файл в server.env (рядом с
#   server.js) и заполните:   cp server.env.example server.env
#
# ВНИМАНИЕ: не загружайте заполненный server.env с настоящими паролями в
# ПУБЛИЧНЫЙ репозиторий GitHub — пароль увидят все. Для Render пароли задавайте
# только в Environment.

# Порт, на котором будет слушать сервер
PORT=8080

# Секрет для подписи JWT-токенов входа.
# ОБЯЗАТЕЛЬНО задайте свою длинную случайную строку в проде.
# Если оставить пустым — сервер сам сгенерирует секрет при первом запуске
# и сохранит его в data/.jwt-secret (тогда просто ничего сюда не пишите).
JWT_SECRET=

# Разрешённый источник для CORS. Например: https://ваш-логин.github.io
# По умолчанию * (разрешены все источники) — этого достаточно, т.к. авторизация
# идёт через Bearer-токен, а не через cookie.
CORS_ORIGIN=*

# Установите true, если сервер стоит за reverse-proxy (nginx, Render, Railway и т.п.)
# — тогда req.ip будет браться из X-Forwarded-For корректно.
TRUST_PROXY=true

# Пароль для входа в супер-админ панель (admin.html) — только для вас,
# владельца сервиса. ОБЯЗАТЕЛЬНО задайте свой длинный уникальный пароль —
# у этой панели доступ ко ВСЕМ зарегистрированным аккаунтам и их данным.
ADMIN_PASSWORD=

# Ключи для push-уведомлений (Web Push VAPID). Необязательно задавать —
# если оставить пустыми, сервер сам сгенерирует пару ключей при первом
# запуске и сохранит в data/vapid.json (тогда просто ничего сюда не пишите).
# Задавать вручную имеет смысл только если сервер работает за балансировщиком
# из нескольких процессов/инстансов без общего диска — тогда всем инстансам
# нужен один и тот же ключ, иначе подписки, выданные одним инстансом, не
# будут работать через другой.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Контактный e-mail, который видят почтовые push-сервисы (FCM/Mozilla и т.п.)
# в случае проблем с вашими уведомлениями — не показывается пользователям.
VAPID_SUBJECT=mailto:admin@xcar.local
